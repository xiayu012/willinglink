# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway 
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Optional: Feedback to WillingLink sends user messages to Telegram.
# Create a bot via @BotFather, then add the token and the chat id (e.g. from @userinfobot or getUpdates).
TELEGRAM_BOT_TOKEN=****
TELEGRAM_CHAT_ID=****

# Optional: shared secret for the /api/xhs/comment-reply route (the userscript's
# AI comment draft). Leave unset and the route is open like the other /api/xhs
# routes; set it and the userscript must send the same value in X-Xhs-Token
# (tools/xhs-guide/userscript config: commentReply.token). Worth setting —
# every call runs a tool-using agent, so an open endpoint burns model credits.
XHS_API_TOKEN=****

# Optional: model id for /api/xhs/comment-reply (defaults to DEFAULT_CHAT_MODEL,
# currently openai/gpt-4.1-mini).
XHS_COMMENT_REPLY_MODEL=****

# Required for the daily /api/cron/clean-forum-listings Vercel Cron job.
# Set this in Vercel's Project Settings -> Environment Variables (random string,
# 16+ chars); Vercel then sends it automatically as the cron request's Bearer token.
CRON_SECRET=****

# Gmail → Google Cloud Pub/Sub send-receipt listener. The only watched mailbox is
# FretGone's own contact@fretgone.com inbox; case-intake mail is retained for audit.
GOOGLE_GMAIL_CLIENT_ID=****
GOOGLE_GMAIL_CLIENT_SECRET=****
GOOGLE_GMAIL_REFRESH_TOKEN=****
GOOGLE_GMAIL_WATCHED_ADDRESS=contact@fretgone.com
# Optional IDR auto-reply configuration for workers/gmail. Deploy
# workers/gmail/apps-script as an API executable, then copy the deployment ID
# from Deploy > Manage deployments (the Apps Script API scripts.run URL requires
# that deployment ID, not the script ID from Project Settings). The OAuth grant
# behind GOOGLE_GMAIL_REFRESH_TOKEN is used for Gmail API reads AND as the
# scripts.run caller. Official documentation says the caller's OAuth must cover
# every scope the Apps Script project uses, so it must include the current
# script's scope: https://mail.google.com/ (for GmailApp), plus the existing
# Gmail API scopes. Re-issue GOOGLE_GMAIL_REFRESH_TOKEN if the current grant
# lacks any of them. The script
# owner must also run authorize in the Apps Script editor once. If this variable
# is unset, receipt ingestion continues and IDR auto-replies stay disabled.
GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=****
# Optional; defaults to sendIdrReply.
GOOGLE_APPS_SCRIPT_FUNCTION=sendIdrReply
GOOGLE_CLOUD_PROJECT_ID=****
GOOGLE_PUBSUB_TOPIC=projects/PROJECT_ID/topics/fretgone-gmail-receipts
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://fretgone.com/api/fretgone/gmail/push
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=pubsub-push@PROJECT_ID.iam.gserviceaccount.com

# 多渠道聊天 adapter（只做 Twilio 短信 SMS：/api/twilio/messages）
# 总开关，默认关闭：这些是无鉴权入口，每次调用会跑一轮带搜索的 agent。
# 打开前先在 Neon 执行 lib/db/migrations/manual/channel-identity.sql。
CHANNEL_ADAPTERS_ENABLED=****
