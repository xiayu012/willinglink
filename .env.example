# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# Instructions to create an AI Gateway API key here: https://vercel.com/ai-gateway 
# API key required for non-Vercel deployments
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# PostgreSQL connection URL (Drizzle + postgres.js read POSTGRES_URL).
# Neon: copy the connection string from https://console.neon.tech into .env.local
# (this repo ignores .env.local). Pooled hosts often include "-pooler" in the hostname.
# Use sslmode=require. If your client cannot connect, try omitting channel_binding=require.
# Vercel Postgres: https://vercel.com/docs/postgres
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Optional: Feedback to WillingLink sends user messages to Telegram.
# Create a bot via @BotFather, then add the token and the chat id (e.g. from @userinfobot or getUpdates).
TELEGRAM_BOT_TOKEN=****
TELEGRAM_CHAT_ID=****

# Optional: shared secret for the /api/xhs/comment-reply route (the userscript's
# AI comment draft). Leave unset and the route is open like the other /api/xhs
# routes; set it and the userscript must send the same value in X-Xhs-Token
# (tools/xhs-guide/userscript config: commentReply.token). Worth setting —
# every call runs a tool-using agent, so an open endpoint burns model credits.
XHS_API_TOKEN=****

# Optional: model id for /api/xhs/comment-reply (defaults to DEFAULT_CHAT_MODEL,
# currently openai/gpt-4.1-mini).
XHS_COMMENT_REPLY_MODEL=****

# Required for the daily /api/cron/clean-forum-listings Vercel Cron job.
# Set this in Vercel's Project Settings -> Environment Variables (random string,
# 16+ chars); Vercel then sends it automatically as the cron request's Bearer token.
CRON_SECRET=****

# 多渠道聊天 adapter（/api/xhs/messages、/api/twilio/messages、/api/wecom/messages）
# 总开关，默认关闭：这些是无鉴权入口，每次调用会跑一轮带搜索的 agent。
# 打开前先在 Neon 执行 lib/db/migrations/manual/channel-identity.sql。
CHANNEL_ADAPTERS_ENABLED=****

# 小红书私信出站：算完之后把回复 POST 到集简云的 webhook。
# 必须放环境变量——这个仓库是公开的，而该 webhook 无鉴权，写进代码等于谁都能
# 往你的自动化流程里灌消息。不配就不投递（日志会说明）。
JIJYUN_WEBHOOK_URL=****

# 私信这条链路用的模型，不设就是 anthropic/claude-sonnet-4.5。
# 比网页那条强是有原因的：私信里要先分辨"这两套还在吗"是是非问句而不是新搜索，
# 小模型做不好这个（见 AGENT_LOG 2026-08-25）。嫌慢/嫌贵可设 openai/gpt-4.1-mini。
XHS_DM_MODEL=****
